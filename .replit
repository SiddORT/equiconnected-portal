modules = ["python-base-3.13", "nodejs-24", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "pkg-config", "rustc", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
ACCESS_TOKEN_EXPIRE_MINUTES = "15"
ALLOWED_ORIGINS = "[\"http://localhost:5000\",\"http://127.0.0.1:5000\"]"
COOKIE_SAMESITE = "lax"
COOKIE_SECURE = "false"
DEBUG = "false"
ENVIRONMENT = "development"
REFRESH_TOKEN_EXPIRE_DAYS = "7"

[userenv.development]
PUBLIC_APP_URL = "https://5f3f19d0-f60a-41e9-b2ff-9d685c044dc2-00-3c15f6nbpkpfs-p34opsyu.sisko.replit.dev"
CONTACT_ENCRYPTION_ACTIVE_KEY_ID = "contact-encryption-key-2026"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "messages-layout"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "messages-layout"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run test:messages-browser:harness && npm run test:messages-browser"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 3000

[[ports]]
localPort = 5003
externalPort = 3002

[[ports]]
localPort = 8000
externalPort = 8000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
