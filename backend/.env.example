# EquiConnected Portal — Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
# Replit provides this automatically — do not override unless using an external DB
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-a-strong-random-secret-key

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── Cookie settings ──────────────────────────────────────────────────────────
COOKIE_SECURE=false    # Set true in production (requires HTTPS)
COOKIE_SAMESITE=lax

# ── Admin seed (used ONLY by scripts/seed_admin.py — not the app) ────────────
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=replace-with-strong-password
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User
