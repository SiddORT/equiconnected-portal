# EquiConnected Portal — Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
# Replit provides this automatically — do not override unless using an external DB
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-a-strong-random-secret-key

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── Cookie settings ──────────────────────────────────────────────────────────
COOKIE_SECURE=false    # Set true in production (requires HTTPS)
COOKIE_SAMESITE=lax

# ── Email / provider invitations ─────────────────────────────────────────────
# Leave SMTP_HOST empty in local development to disable delivery explicitly.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
EMAIL_TLS=true
# Public frontend URL used when constructing invitation links
PUBLIC_APP_URL=http://localhost:5000
# Invitation lifetime; resends reset the expiry using this value
INVITATION_EXPIRE_DAYS=7

# ── Admin seed (used ONLY by scripts/seed_admin.py — not the app) ────────────
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=replace-with-strong-password
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User
