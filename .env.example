# EquiConnected Portal — Root environment variables example
# See backend/.env.example for full backend configuration.
# See frontend/.env.example for frontend configuration.

# Backend
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=replace-with-a-strong-random-secret-key
ENVIRONMENT=development

# Admin seed (only for scripts/seed_admin.py)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=replace-with-strong-password
